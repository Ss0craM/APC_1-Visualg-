algoritmo "lanchonete"

var
  opcao: inteiro

inicio
  escreval("1 - Hambúrguer | 2 - Pizza | 3 - Salada")
  leia(opcao)

  escolha opcao
    caso 1
      escreval("O Hambúrguer foi escolhido!")
    caso 2
      escreval("A pizza foi escolhida!")
    caso 3
      escreval("A salada foi escolhida!")
  fimescolha

fimalgoritmo
